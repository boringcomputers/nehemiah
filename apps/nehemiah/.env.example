NODE_ENV=development
PORT=8081
NEHEMIAH_HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nehemiah
NEHEMIAH_HOST_CREDENTIAL_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
NEHEMIAH_HOST_CIDRS=127.0.0.0/8,10.0.0.0/8,fd00::/8
NEHEMIAH_HOST_PORT=8080
NEHEMIAH_GATEWAY_TOKEN=replace-me
NEHEMIAH_GATEWAY_SECRET=replace-me-too
# Generate 32 random bytes, base64 encode them, and keep this pepper distinct.
# Rotation invalidates only pending device codes (which expire within 10 minutes).
NEHEMIAH_DEVICE_CODE_PEPPER=replace-with-canonical-base64-32-byte-key
NEHEMIAH_GATEWAY_URL=http://localhost:8082
NEHEMIAH_DEVICE_VERIFICATION_URL=http://localhost:5173/dashboard/device
# Production requires wildcard DNS/TLS on a dedicated user-content registrable
# domain, separate from the dashboard/API site.
NEHEMIAH_PREVIEW_BASE_DOMAIN=preview-user-content.example
NEHEMIAH_TRUSTED_SITE_DOMAIN=example.com
NEHEMIAH_HOST_STALE_MS=30000
NEHEMIAH_DEFAULT_REGION=ca-tor-1
# PostgreSQL-backed fixed-window REST admission. All control-plane replicas must
# use the same values. Production refuses disabled or fail-open admission.
NEHEMIAH_API_RATE_LIMIT_ENABLED=true
NEHEMIAH_API_RATE_LIMIT_FAIL_CLOSED=true
NEHEMIAH_API_RATE_WINDOW_SECONDS=60
NEHEMIAH_API_PREAUTH_IP_REQUESTS=300
NEHEMIAH_API_PREAUTH_KEY_REQUESTS=60
NEHEMIAH_API_PRINCIPAL_REQUESTS=600
NEHEMIAH_API_PROJECT_REQUESTS=3000
NEHEMIAH_API_ORGANIZATION_REQUESTS=12000
# CLERK_ISSUER=https://example.clerk.accounts.dev
# CLERK_AUDIENCE=nehemiah-local
# STRIPE_WEBHOOK_SECRET=whsec_replace-me

# Optional S3-compatible template storage. Configure every required value or
# none. Use a dedicated service principal limited to ListBucket/ListBucketVersions
# with an organizations/* prefix condition and GetObject, PutObject, DeleteObject,
# and DeleteObjectVersion on those objects; do not grant bucket administration or
# ACL permissions.
# Durable publication and cross-host activation are opt-in. Enabling the flag
# without this complete S3 block fails startup; leaving it unset preserves the
# typed 503 for publication. Provision hosts with the exact presigned origin.
# Development/test only. Production rejects enablement until aggregate template
# storage quotas and durable replica/object eviction are implemented.
# NEHEMIAH_TEMPLATE_TRANSFERS_ENABLED=true
# NEHEMIAH_TEMPLATE_REPLICATION_INTERVAL_MS=5000
# NEHEMIAH_TEMPLATE_HOST_TIMEOUT_MS=900000
# Raw S3 PUT is never issued for volumes; enable the bounded broker below.
# The provider must support SSE-S3 (AES256) and native full-object SHA-256 on
# PutObject/HeadObject; services with a weaker compatibility subset fail closed.
# NEHEMIAH_S3_ENDPOINT=https://objects.storage-provider.example
# NEHEMIAH_S3_REGION=us-east-1
# NEHEMIAH_S3_BUCKET=nehemiah-template-artifacts
# NEHEMIAH_S3_ACCESS_KEY_ID=replace-with-scoped-key-id
# NEHEMIAH_S3_SECRET_ACCESS_KEY=replace-with-scoped-secret
# NEHEMIAH_S3_SESSION_TOKEN=optional-temporary-session-token
# NEHEMIAH_S3_FORCE_PATH_STYLE=false

# Non-production contract testing only. Production startup rejects this broker
# until durable volume/revision-count quotas and global transfer admission are
# enforced. Both values and the complete S3 group above are otherwise required.
# NEHEMIAH_VOLUME_BROKER_URL=https://api.example.com
# NEHEMIAH_VOLUME_BROKER_SECRET=replace-with-canonical-base64-32-byte-key

# Optional central telemetry. Leave the whole group unset locally. Once
# enabled, every value is required/validated and the origin must use HTTPS.
# Give each process its own collector Basic credential and stable instance ID.
# NEHEMIAH_OTEL_ENABLED=true
# NEHEMIAH_OTEL_ENDPOINT=https://otel-collector.internal.example
# NEHEMIAH_OTEL_AUTHORIZATION=Basic REPLACE_WITH_BASE64_UNIQUE_PROCESS_CREDENTIAL
# NEHEMIAH_SERVICE_VERSION=2026.08.09
# NEHEMIAH_INSTANCE_ID=control-local-1
# NEHEMIAH_DEPLOYMENT_ENVIRONMENT=development
# NEHEMIAH_OTEL_EXPORT_INTERVAL_MS=15000
# NEHEMIAH_OTEL_EXPORT_TIMEOUT_MS=10000
# NEHEMIAH_OTEL_TRACE_SAMPLE_RATIO=0.1
