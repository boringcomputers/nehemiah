{
	"name": "@nehemiah/nehemiah",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/main.ts",
		"build": "tsc",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"lint": "prettier --check src test",
		"format": "prettier --write src test",
		"migrate": "tsx src/db/migrate.ts"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"effect": "^3.12.0",
		"jose": "^6.1.3",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@nehemiah/prettier-config": "*",
		"@nehemiah/typescript-config": "*",
		"@types/node": "^24",
		"@types/pg": "^8.15.5",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"prettier": "@nehemiah/prettier-config"
}
