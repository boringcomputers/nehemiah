# apps/web environment — all optional.
#
# --- Local dev (`npm run dev`) ---
# The Vite /boring proxy forwards to NEHEMIAH_URL (default http://localhost:8080).
# Run your own nehemiahd (see the repo README) and point at it:
#   NEHEMIAH_URL=http://localhost:8080
#   NEHEMIAH_TOKEN=<token-if-you-set-one>
#
# --- Production (Cloudflare Workers, deployed by `npm run deploy`) ---
# alchemy.run.ts forwards the settings below to the Worker when they are set
# in the deploying shell, this file, or CI (see docs/cloudflare.md).
# The browser talks to nehemiahd directly (the TTY/VNC/agent are WebSockets and
# can't go through the Worker), so expose your endpoint publicly:
#   PUBLIC_NEHEMIAH_URL=https://your-nehemiahd.example.com
#
# Optional: auto-open an SSH tunnel to a remote/private nehemiahd when you run
# `npm run dev`. Set NEHEMIAH_TUNNEL to an SSH host; the launcher forwards the port
# from NEHEMIAH_URL to that host's nehemiahd (localhost:8080), and closes it on exit.
#   NEHEMIAH_URL=http://localhost:18099
#   NEHEMIAH_TUNNEL=user@your-box        # or an ~/.ssh/config alias

# --- Managed-cloud dashboard ---
# Browser-safe Clerk configuration. ClerkJS is loaded from this Frontend API,
# not from an arbitrary CDN.
#   PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
#   PUBLIC_CLERK_FRONTEND_API=example.clerk.accounts.dev
# Server-only control-plane origin used by /dashboard/api. Never prefix PRIVATE_
# values with PUBLIC_ and never put host or gateway credentials in this app.
#   PRIVATE_NEHEMIAH_URL=http://127.0.0.1:8081

# --- Public status and support pages ---
# These origins are read only by the server-rendered /status page. Production
# requires origin-only HTTPS URLs; local development permits loopback HTTP. The
# probes call only unauthenticated /healthz and /readyz endpoints and never send
# tokens, cookies, customer identifiers, or host identifiers.
#   STATUS_CONTROL_PLANE_URL=https://api.boringcomputers.com
#   STATUS_GATEWAY_URL=https://gateway.boringcomputers.com
# Optional public support contacts. Unsafe values are omitted from the page.
#   PUBLIC_SUPPORT_URL=https://support.boringcomputers.com/help
#   PUBLIC_SUPPORT_EMAIL=support@boringcomputers.com

# --- Cloudflare stack (deploy time only; never read by the app) ---
# Local deploys authenticate with `npx alchemy profile edit --add Cloudflare`.
# CI sets these two instead:
#   CLOUDFLARE_ACCOUNT_ID=
#   CLOUDFLARE_API_TOKEN=
# Stage: `prod` owns the domain, analytics, R2 bucket, the control plane and
# gateway containers, the edge Worker, and the Access applications. Any other
# stage deploys the site alone on workers.dev. See docs/cloudflare.md.
#   ALCHEMY_STAGE=prod
#   SITE_DOMAIN=boringcomputers.com
#   API_HOSTNAME=api.boringcomputers.com          # control plane container
#   GATEWAY_HOSTNAME=gateway.boringcomputers.com  # gateway container
# Machine previews need their own registrable domain (not a subdomain of the
# site); prod requires it.
#   PREVIEW_BASE_DOMAIN=example-previews.app
#   PREVIEW_ZONE_NAME=example-previews.app        # zone holding it (default: same)
# Hosts publish their tunnels at <address label>.<this domain> (ADR 0005).
#   HOST_TUNNEL_DOMAIN=hosts.boringcomputers.com
#   FLEET_ACCESS_TOKEN_ID=                        # Access service token hosts present
#   R2_BUCKET=nehemiah-artifacts
# Container settings (prod). Secrets are forwarded redacted; the control plane
# and gateway validate them at start (apps/nehemiah/.env.example, gateway/config.go).
#   NEHEMIAH_SERVICE_VERSION=                     # managed-host release version
#   NEHEMIAH_OTEL_ENDPOINT=
#   NEHEMIAH_OTEL_AUTHORIZATION=
#   GATEWAY_OTEL_AUTHORIZATION=                   # optional; defaults to the above
#   NEHEMIAH_DEFAULT_REGION=ca-tor-1
#   NEHEMIAH_HOST_CIDRS=10.64.0.0/16,fd00:6e65:6865::/64
#   DATABASE_URL=                                 # sslmode=verify-full
#   CLERK_ISSUER=
#   CLERK_AUDIENCE=
#   NEHEMIAH_HOST_CREDENTIAL_KEY=
#   NEHEMIAH_GATEWAY_TOKEN=
#   NEHEMIAH_GATEWAY_SECRET=
#   NEHEMIAH_DEVICE_CODE_PEPPER=
#   STRIPE_WEBHOOK_SECRET=
