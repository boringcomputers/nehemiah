{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.alchemy.json && tsc --noEmit -p tsconfig.edge.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:e2e": "playwright install && playwright test",
		"deploy": "alchemy deploy",
		"plan": "alchemy plan",
		"destroy": "alchemy destroy"
	},
	"devDependencies": {
		"@alchemy.run/frontend-frameworks": "2.0.0-beta.79",
		"@cloudflare/containers": "0.3.7",
		"@cloudflare/workers-types": "^5.20260919.1",
		"@effect/platform-node": "4.0.0-rc.116",
		"@nehemiah/eslint-config": "*",
		"@nehemiah/prettier-config": "*",
		"@nehemiah/typescript-config": "*",
		"@playwright/test": "^1.60.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.10",
		"alchemy": "2.0.0-beta.79",
		"effect": "4.0.0-rc.116",
		"eslint": "^10.4.1",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@novnc/novnc": "^1.7.0",
		"@xterm/addon-fit": "^0.10.0",
		"@xterm/xterm": "^5.5.0",
		"cookie": "0.7.2"
	}
}
