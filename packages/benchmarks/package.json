{
	"name": "@nehemiah/benchmarks",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"test": "node --test test/*.test.mjs",
		"check": "node --check src/run.mjs && node --check src/stats.mjs",
