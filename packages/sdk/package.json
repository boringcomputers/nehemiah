{
	"name": "nehemiah-sdk",
	"version": "0.2.0-beta.0",
	"description": "Effect-native client for Boring Computers Cloud, self-hosted Nehemiah, and local Firecracker microVMs.",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/boringcomputers/nehemiah.git",
		"directory": "packages/sdk"
	},
	"homepage": "https://github.com/boringcomputers/nehemiah#readme",
	"keywords": [
		"firecracker",
		"microvm",
		"sandbox",
		"ai",
		"agents",
		"effect",
		"cloud"
	],
	"engines": {
		"node": ">=20"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"prettier": "@nehemiah/prettier-config",
	"scripts": {
		"check": "tsc --noEmit",
		"build": "tsc",
		"test": "vitest run",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"effect": "^3.12.0"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"@nehemiah/typescript-config": "*",
		"@nehemiah/prettier-config": "*",
		"@types/node": "^24",
		"vitest": "^4.1.10"
	}
}
