# One-shot migration job only. Never inject this file or its owner credential
# into the long-running control-plane deployment.
NODE_ENV=production
DATABASE_URL=postgres://nehemiah_app:replace-me@staging-db/nehemiah?sslmode=verify-full
MIGRATION_DATABASE_URL=postgres://nehemiah_migrator:replace-separately@staging-db/nehemiah?sslmode=verify-full
