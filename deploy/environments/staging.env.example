NODE_ENV=production
PORT=8081
DATABASE_URL=postgres://nehemiah_app:replace-me@staging-db/nehemiah?sslmode=verify-full
NEHEMIAH_HOST_CREDENTIAL_KEY=replace-with-base64-encoded-32-byte-key
NEHEMIAH_HOST_CIDRS=10.64.0.0/16
NEHEMIAH_GATEWAY_TOKEN=replace-with-32-random-bytes
NEHEMIAH_GATEWAY_SECRET=replace-with-a-separate-32-byte-signing-secret
# Canonical base64 for 32 random bytes. Rotating it invalidates only unexpired
# device codes (at most 10 minutes), never issued refresh/access credentials.
NEHEMIAH_DEVICE_CODE_PEPPER=replace-with-a-distinct-canonical-base64-32-byte-key
NEHEMIAH_CONTROL_PLANE_URL=https://nehemiah-control-plane.staging.internal
NEHEMIAH_CONTROL_PLANE_CA_FILE=/run/secrets/nehemiah-control-plane-ca.pem
NEHEMIAH_CONTROL_PLANE_SERVER_NAME=nehemiah-control-plane.staging.internal
NEHEMIAH_GATEWAY_ALLOWED_HOST_CIDRS=10.64.0.0/16
NEHEMIAH_GATEWAY_REST_REQUESTS_PER_WINDOW=600
NEHEMIAH_GATEWAY_REST_WINDOW=1m
NEHEMIAH_GATEWAY_REST_LIMITER_SLOTS=65536
NEHEMIAH_GATEWAY_REST_MAX_ACTIVE=256
NEHEMIAH_GATEWAY_REST_MAX_ACTIVE_PER_SOURCE=16
NEHEMIAH_GATEWAY_REST_BODY_TIMEOUT=15s
NEHEMIAH_GATEWAY_REST_MAX_DURATION=150s
# Active streams fail closed on issuer/grant revocation. With the default
# control-plane timeout, 5s bounds detection plus resolution to about 10s.
NEHEMIAH_GATEWAY_CAPABILITY_REVALIDATION_INTERVAL=5s
NEHEMIAH_GATEWAY_SHUTDOWN_GRACE=30s
NEHEMIAH_GATEWAY_TRUSTED_EDGE_IP_HEADER=CF-Connecting-IP
# NEHEMIAH_GATEWAY_TRUSTED_EDGE_CIDRS=replace-with-pinned-edge-origin-cidrs
NEHEMIAH_GATEWAY_URL=https://gateway.staging.boringcomputers.com
NEHEMIAH_DEVICE_VERIFICATION_URL=https://staging.boringcomputers.com/dashboard/device
NEHEMIAH_PREVIEW_BASE_DOMAIN=staging.boringcomputers-preview.net
NEHEMIAH_TRUSTED_SITE_DOMAIN=boringcomputers.com
NEHEMIAH_DEFAULT_REGION=ca-tor-1
NEHEMIAH_API_RATE_LIMIT_ENABLED=true
NEHEMIAH_API_RATE_LIMIT_FAIL_CLOSED=true
NEHEMIAH_API_RATE_WINDOW_SECONDS=60
NEHEMIAH_API_PREAUTH_IP_REQUESTS=300
NEHEMIAH_API_PREAUTH_KEY_REQUESTS=60
NEHEMIAH_API_PRINCIPAL_REQUESTS=600
NEHEMIAH_API_PROJECT_REQUESTS=3000
NEHEMIAH_API_ORGANIZATION_REQUESTS=12000
NEHEMIAH_REGION=ca-tor-1
CLERK_ISSUER=https://replace-me.clerk.accounts.dev
CLERK_AUDIENCE=nehemiah-staging
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# Render this block separately for each control-plane/gateway process. Never
# mount one rendered credential or instance ID into both services.
NEHEMIAH_OTEL_ENABLED=true
NEHEMIAH_OTEL_ENDPOINT=https://otel-collector.staging.internal
NEHEMIAH_OTEL_AUTHORIZATION=Basic REPLACE_WITH_BASE64_UNIQUE_PROCESS_CREDENTIAL
NEHEMIAH_SERVICE_VERSION=replace-with-release-version
NEHEMIAH_INSTANCE_ID=replace-with-stable-instance-id
NEHEMIAH_DEPLOYMENT_ENVIRONMENT=staging
NEHEMIAH_OTEL_EXPORT_INTERVAL_MS=15000
NEHEMIAH_OTEL_EXPORT_TIMEOUT_MS=10000
NEHEMIAH_OTEL_TRACE_SAMPLE_RATIO=0.1
